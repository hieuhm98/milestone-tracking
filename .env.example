# Everything below is optional. With no Supabase variables the app runs exactly
# as before: public, no accounts, progress kept in localStorage only.

# --- Supabase (accounts + cross-device progress) ---------------------------
# Project Settings → API. Run supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by sign-up, Telegram linking and the cron.
SUPABASE_SERVICE_ROLE_KEY=

# The site is closed to visitors whenever Supabase is configured: nothing is
# reachable until an approved account signs in. Set to 0 to open it up again
# (and redeploy — NEXT_PUBLIC_* values are baked into the build).
NEXT_PUBLIC_REQUIRE_LOGIN=1

# Login is phone + password; each phone maps to p<digits>@<this domain> in
# Supabase Auth (never emailed). Optional. Set it once and never change it.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=phone.milestone-tracking.invalid

# Public URL of the site, used for links in Telegram messages and the webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (daily learning notifications) -------------------------------
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Without the @. Optional — looked up with getMe when empty.
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional: your own chat id, to be pinged when someone signs up.
TELEGRAM_ADMIN_CHAT_ID=

# --- Daily digest cron -----------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# --- API practice sandbox (/practice/api) ----------------------------------
# Signs sandbox keys and the bookstore's login JWTs. Optional: falls back to
# SUPABASE_SERVICE_ROLE_KEY. Changing it invalidates every issued key/token.
SANDBOX_SECRET=

# --- Gemini (IELTS Writing mock test) --------------------------------------
# Free key from https://aistudio.google.com/apikey. Server only. Without it (or
# when every model is out of free quota) the writing test falls back to a
# rule-based estimate of Task Response / Coherence, capped at band 6.5 and labelled.
GEMINI_API_KEY=
# Optional. Defaults to gemini-4-hydrogen (free tier). Fallbacks with a free tier:
# gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite.
GEMINI_MODEL=
# Optional comma list tried in order when one model is out of quota. Defaults to
# gemini-4-hydrogen, gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite.
GEMINI_MODELS=
