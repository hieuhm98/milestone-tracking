# Everything below is optional. With no Supabase variables the app runs exactly
# as before: public, no accounts, progress kept in localStorage only.

# --- Supabase (accounts + cross-device progress) ---------------------------
# Project Settings → API. Run supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by sign-up, Telegram linking and the cron.
SUPABASE_SERVICE_ROLE_KEY=

# Login is phone + password; each phone maps to p<digits>@<this domain> in
# Supabase Auth (never emailed). Optional. Set it once and never change it.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=phone.milestone-tracking.invalid

# Public URL of the site, used for links in Telegram messages and the webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (daily learning notifications) -------------------------------
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Without the @. Optional — looked up with getMe when empty.
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional: your own chat id, to be pinged when someone signs up.
TELEGRAM_ADMIN_CHAT_ID=

# --- Daily digest cron -----------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
